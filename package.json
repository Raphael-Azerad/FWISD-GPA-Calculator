  "private": false,
  "description": "A simple open-source Fort Worth ISD GPA and final grade calculator.",
  "license": "MIT",
  "author": "Raphael Azerad",
  "homepage": "https://fwisd-gpa-calculator.mysterious-flute.workers.dev/",
  "repository": {
